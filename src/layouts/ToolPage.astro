---
import ImageStudio from '../components/ImageStudio';
import PageHead from '../components/PageHead.astro';
import { locales, localizedPaths, shellCopy } from '../data/locales';
import { content, pagePath, tools, type Language, type Tool } from '../data/seo';
import '../styles/global.css';
interface Props { language: Language; tool: Tool }
const { language, tool } = Astro.props;
const copy = content[language][tool];
const t = shellCopy[language];
---
<!doctype html>
<html lang={locales[language].tag} transition:animate="none">
  <head>
    <PageHead language={language} title={copy.title} description={copy.description} paths={localizedPaths(tool === 'home' ? '' : `${tool}/`)} />
  </head>
  <body>
    <ImageStudio language={language} tool={tool} headline={copy.headline} intro={copy.intro} client:load transition:persist={`studio-${tool}`} />
    <section class="tool-guide" id="guide" aria-labelledby="guide-title">
      <div class="guide-heading">
        <div><span class="section-index">03 / {t.guide}</span><h2 id="guide-title">{copy.guideTitle}</h2></div>
        <a href="#top">{t.back}</a>
      </div>
      <ol class="guide-steps">
        {copy.steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><p>{step}</p></li>)}
      </ol>
      <p class="guide-tip">{copy.tip}</p>
      <div class="guide-bottom">
        <section aria-labelledby="faq-title">
          <h2 id="faq-title">{t.faq}</h2>
          {copy.faqs.map(([question, answer]) => <details class="guide-faq"><summary>{question}</summary><p>{answer}</p></details>)}
        </section>
        <nav class="related-tools" aria-labelledby="tools-title">
          <h2 id="tools-title">{t.explore}</h2>
          {tools.filter((other) => other !== tool).map((other) => <a href={pagePath(language, other)}><span>{content[language][other].label}</span><span aria-hidden="true">↗</span></a>)}
          <p>{t.free}</p>
        </nav>
      </div>
    </section>
  </body>
</html>
