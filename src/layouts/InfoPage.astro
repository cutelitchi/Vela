---
import PageHead from '../components/PageHead.astro';
import SiteLinks from '../components/SiteLinks';
import LanguageMenu from '../components/LanguageMenu';
import { infoContent, infoLabels, type InfoPage } from '../data/info';
import { locales, localizedPaths, shellCopy } from '../data/locales';
import { pagePath, type Language } from '../data/seo';
import '../styles/global.css';
interface Props { language: Language; page: InfoPage }
const { language, page } = Astro.props;
const copy = infoContent[language][page];
const t = shellCopy[language];
const paths = localizedPaths(`${page}/`);
---
<!doctype html>
<html lang={locales[language].tag} transition:animate="none">
  <head><PageHead language={language} title={copy.title} description={copy.description} paths={paths} /></head>
  <body>
    <div class="app-shell info-shell">
      <header class="site-header">
        <a class="brand" href={pagePath(language)} aria-label="PicSizeKit home">
          <span class="brand-mark"><span /></span><span><strong>PicSizeKit</strong><small>{t.brand}</small></span>
        </a>
        <LanguageMenu language={language} paths={paths} />
      </header>
      <main class="info-main">
        <div class="info-hero"><span class="section-index">PICSIZEKIT / {page.toUpperCase()}</span><h1>{infoLabels[language][page]}</h1><p>{copy.intro}</p></div>
        <div class="info-grid">
          <aside class="info-sidebar">
            <SiteLinks language={language} current={page} />
            <a class="info-back" href={pagePath(language)}>{t.open}</a>
          </aside>
          <!--email_off-->
          <article class="info-article" aria-label={infoLabels[language][page]}>
            {copy.sections.map((section) => <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.links && <ul class="info-resource-links">{section.links.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>}
            </section>)}
            {page === 'privacy' && <p class="info-updated">{t.updated}<time datetime="2026-09-11">2026-09-11</time></p>}
          </article>
          <!--/email_off-->
        </div>
      </main>
      <footer class="info-footer"><span>PicSizeKit / 2026</span><SiteLinks language={language} current={page} /><a href={pagePath(language)}>{t.tools}</a></footer>
    </div>
  </body>
</html>
