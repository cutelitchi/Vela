---
import { ClientRouter } from 'astro:transitions';
import { site, type Language } from '../data/seo';
import { languages, locales } from '../data/locales';
interface Props { language: Language; title: string; description: string; paths: Record<Language, string> }
const { language, title, description, paths } = Astro.props;
const canonical = site + paths[language];
---
<meta charset="UTF-8" />
<ClientRouter />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#09111f" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{languages.map((code) => <link rel="alternate" hreflang={locales[code].tag} href={site + paths[code]} />)}
<link rel="alternate" hreflang="x-default" href={site + paths.en} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="PicSizeKit" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locales[language].og} />
{languages.filter((code) => code !== language).map((code) => <meta property="og:locale:alternate" content={locales[code].og} />)}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
