---
import '../styles/global.css';
import { languages, locales } from '../data/locales';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Page not found | PicSizeKit</title>
  </head>
  <body>
    <main class="not-found"><span class="section-index">404 / PICSIZEKIT</span><h1>We couldn’t find that page.</h1><p>Choose your language to open the image tools.</p>{languages.map((code) => <a href={locales[code].prefix} lang={locales[code].tag}>{locales[code].name} →</a>)}</main>
  </body>
</html>
